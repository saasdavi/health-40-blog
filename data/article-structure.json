  "guidelines": {
    "h1-structure": "Um único H1 que é o título do artigo",
    "h2-count": "4-6 H2s (seções principais)",
    "h3-per-h2": "3-4 H3s por H2",
    "content-per-section": "200-400 palavras por seção",
    "image-placement": "Uma imagem a cada 2-3 seções",
    "alt-text-requirement": "Alt text descritivo, 100-150 caracteres",
    "internal-links": "3-5 links internos para outros artigos do blog",
    "external-links": "3-5 links para fontes confiáveis (não concorrentes)",
    "word-count-target": "1500-2500 palavras (pode variar conforme complexidade)",
    "reading-time": "7-12 minutos",
    "tone": "Profissional mas acessível. Especialista não condescendente.",
    "voice": "Conselho prático de especialista que entende desafios dos 40+",
    "e-e-a-t-checklist": [
      "Tem autor identificado?",
      "Tem disclaimer de saúde?",
      "Tem 3+ fontes citadas?",
      "Tem 1500+ palavras?",
      "Tem alt text em todas as imagens?",
      "Tem crédito de imagem?",
      "Tem health warning ativo?",
      "Tem 4+ seções bem estruturadas?"
    ]
