---
// Footer.astro - Rodapé profissional
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-content">
    <div class="footer-section">
      <h4>Health 40+</h4>
      <p>Conteúdo original e pesquisado sobre saúde para mulheres 40+</p>
      <div class="social-links">
        <a href="#" aria-label="Facebook">f</a>
        <a href="#" aria-label="Instagram">@</a>
        <a href="#" aria-label="Twitter">𝕏</a>
      </div>
    </div>

    <div class="footer-section">
      <h4>Links Rápidos</h4>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/sobre">Sobre</a></li>
        <li><a href="/contato">Contato</a></li>
      </ul>
    </div>

    <div class="footer-section">
      <h4>Legal</h4>
      <ul>
        <li><a href="/politica-privacidade">Política de Privacidade</a></li>
        <li><a href="/termos-uso">Termos de Uso</a></li>
      </ul>
    </div>

    <div class="footer-section">
      <h4>Newsletter</h4>
      <p>Receba dicas semanais de saúde:</p>
      <form class="newsletter-form">
        <input
          type="email"
          placeholder="seu@email.com"
          required
          aria-label="Email"
        />
        <button type="submit">Inscrever</button>
      </form>
    </div>
  </div>

  <div class="footer-bottom">
    <p>© {currentYear} Health 40+. Todos os direitos reservados.</p>
    <p class="disclaimer">
      *Este site é informativo. Consulte um profissional de saúde antes de fazer
      mudanças significativas em sua rotina.
    </p>
  </div>
</footer>

<style>
  .footer {
    background: #1a1a1a;
    color: #ccc;
    padding: 3rem 2rem 2rem;
    margin-top: 3rem;
  }

  .footer-content {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .footer-section h4 {
    color: #fff;
    font-size: 1rem;
    margin-bottom: 1rem;
    font-weight: bold;
  }

  .footer-section p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #aaa;
    margin-bottom: 1rem;
  }

  .footer-section ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-section li {
    margin-bottom: 0.5rem;
  }

  .footer-section a {
    color: #aaa;
    text-decoration: none;
    border: none;
    font-size: 0.9rem;
    transition: color 300ms ease;
  }

  .footer-section a:hover {
    color: #667eea;
    border: none;
  }

  .social-links {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: #333;
    border-radius: 4px;
    font-weight: bold;
  }

  .newsletter-form {
    display: flex;
    gap: 0.5rem;
  }

  .newsletter-form input {
    flex: 1;
    padding: 0.6rem 1rem;
    border: 1px solid #444;
    border-radius: 4px;
    background: #2a2a2a;
    color: #fff;
    font-size: 0.9rem;
  }

  .newsletter-form input::placeholder {
    color: #666;
  }

  .newsletter-form button {
    padding: 0.6rem 1.5rem;
    background: #667eea;
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-weight: bold;
    transition: background 300ms ease;
  }

  .newsletter-form button:hover {
    background: #764ba2;
  }

  .footer-bottom {
    border-top: 1px solid #333;
    padding-top: 2rem;
    text-align: center;
    font-size: 0.85rem;
    color: #666;
  }

  .footer-bottom p {
    margin-bottom: 0.5rem;
  }

  .disclaimer {
    font-size: 0.8rem;
    color: #555;
  }

  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .newsletter-form {
      flex-direction: column;
    }
  }
</style>
