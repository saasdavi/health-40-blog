---
import BaseLayout from './BaseLayout.astro';
import { SITE } from '../config/site';

interface Props {
  title: string;
  description: string;
  path: string;
  updated?: string;
}

const { title, description, path, updated } = Astro.props;
const year = new Date().getFullYear();
---

<BaseLayout title={title} description={description} path={path}>
  <header class="pg-header">
    <div class="pg-wrap pg-header-in">
      <a href="/" class="pg-brand">
        <img src="/logo.svg" alt={SITE.name} height="40" />
      </a>
      <nav class="pg-nav" aria-label="Principal">
        <a href="/">Início</a>
        <a href="/artigos/">Artigos</a>
        <a href="/sobre/">Sobre</a>
        <a href="/contato/">Contato</a>
      </nav>
    </div>
  </header>

  <main class="pg-wrap pg-main">
    <h1>{title}</h1>
    {updated && <p class="pg-updated">Última atualização: {updated}</p>}
    <div class="pg-prose"><slot /></div>
  </main>

  <footer class="pg-footer">
    <div class="pg-wrap">
      <nav class="pg-footer-nav" aria-label="Institucional">
        <a href="/">Início</a>
        <a href="/sobre/">Sobre</a>
        <a href="/contato/">Contato</a>
        <a href="/politica-editorial/">Política editorial</a>
        <a href="/aviso-medico/">Aviso médico</a>
        <a href="/divulgacao-afiliados/">Divulgação de afiliados</a>
        <a href="/politica-privacidade/">Privacidade</a>
        <a href="/termos-uso/">Termos de uso</a>
      </nav>
      <p>© {year} {SITE.name} • Todos os direitos reservados</p>
      {(SITE.legal.razaoSocial || SITE.legal.cnpj) && (
        <p class="legal-info">{[SITE.legal.razaoSocial, SITE.legal.cnpj && `CNPJ ${SITE.legal.cnpj}`, SITE.legal.endereco].filter(Boolean).join(' • ')}</p>
      )}
    </div>
  </footer>
</BaseLayout>

<style is:global>
  body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: #2d3748; background: #fff; line-height: 1.7; }
  .pg-wrap { max-width: 820px; margin: 0 auto; padding: 0 1.25rem; }
  .pg-header { border-bottom: 1px solid #e8eaf2; background: #fff; }
  .pg-header-in { display: flex; align-items: center; justify-content: space-between; min-height: 64px; }
  .pg-nav { display: flex; gap: 1.25rem; }
  .pg-nav a, .pg-footer-nav a { color: #4a5568; text-decoration: none; font-size: 0.95rem; }
  .pg-nav a:hover, .pg-footer-nav a:hover { color: #667eea; text-decoration: underline; }
  .pg-main { padding-top: 2.5rem; padding-bottom: 3rem; }
  .pg-main h1 { font-size: 2rem; line-height: 1.25; margin: 0 0 0.5rem; color: #1a202c; }
  .pg-updated { font-size: 0.9rem; color: #718096; margin: 0 0 2rem; }
  .pg-prose h2 { font-size: 1.35rem; margin: 2rem 0 0.6rem; color: #1a202c; }
  .pg-prose p, .pg-prose li { font-size: 1.05rem; }
  .pg-prose ul { padding-left: 1.4rem; }
  .pg-prose a { color: #5a67d8; }
  .pg-footer { background: #f7f8fc; border-top: 1px solid #e8eaf2; padding: 2rem 0; text-align: center; color: #718096; font-size: 0.9rem; }
  .pg-footer-nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 1.25rem; margin-bottom: 1rem; }
  @media (max-width: 560px) { .pg-main h1 { font-size: 1.6rem; } }
</style>
